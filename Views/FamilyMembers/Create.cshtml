@model Zazzo.ChoresWizard2000.Models.FamilyMember
@{
    ViewData["Title"] = "Create Family Member";
}

<header class="page-heading">
    <div>
        <h1>Add Family Member</h1>
        <p>Invite someone new to the household Sorting Ceremony.</p>
    </div>
</header>

<wa-card class="form-card">
    <form asp-action="Create" method="post" class="wa-form">
        @Html.AntiForgeryToken()
        <partial name="_Form" model="@Model" />
        <div class="form-actions">
            <wa-button type="submit" variant="brand" appearance="filled">
                <wa-icon slot="start" name="user-plus"></wa-icon>
                Create
            </wa-button>
            <wa-button href="@Url.Action("Index")" variant="neutral" appearance="outlined">Cancel</wa-button>
        </div>
    </form>
</wa-card>
