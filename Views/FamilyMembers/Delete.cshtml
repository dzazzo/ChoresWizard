@model Zazzo.ChoresWizard2000.Models.FamilyMember
@{
    ViewData["Title"] = "Delete Family Member";
}

<wa-card class="form-card danger-card">
    <div slot="header" class="card-heading">
        <wa-icon name="triangle-exclamation"></wa-icon>
        <h1>Delete Family Member</h1>
    </div>
    <p>Are you sure you want to delete <strong>@Model.Name</strong>? Their assignments will also be removed.</p>
    <form asp-action="Delete" method="post" class="form-actions">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <wa-button type="submit" variant="danger" appearance="filled">
            <wa-icon slot="start" name="trash"></wa-icon>
            Delete
        </wa-button>
        <wa-button href="@Url.Action("Index")" variant="neutral" appearance="outlined">Cancel</wa-button>
    </form>
</wa-card>
