@model Zazzo.ChoresWizard2000.Models.ChoreAssignment
@{
    ViewData["Title"] = "Reassign Chore";
}

<header class="page-heading">
    <div>
        <h1>✏️ Reassign Chore</h1>
        <p>Move this month's assignment without changing future Sorting Ceremonies.</p>
    </div>
</header>

<wa-card class="form-card">
    <h2 slot="header">@Model.Chore?.Name</h2>
    @if (!string.IsNullOrWhiteSpace(Model.Chore?.Description))
    {
        <p>@Model.Chore.Description</p>
    }
    <div class="badge-cluster">
        <wa-badge variant="neutral">@Model.Chore?.Frequency</wa-badge>
        @if (!string.IsNullOrWhiteSpace(Model.Chore?.Category))
        {
            <wa-badge variant="brand">@Model.Chore.Category</wa-badge>
        }
    </div>
    @if (Model.Chore?.PinnedToFamilyMemberId.HasValue == true)
    {
        <wa-callout variant="warning" class="page-callout">
            📌 This chore is pinned. This change applies now, but the Sorting Hat will use the pinned person next month.
        </wa-callout>
    }

    <form asp-action="Edit" method="post" class="wa-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <wa-select name="FamilyMemberId"
                   id="FamilyMemberId"
                   value="@Model.FamilyMemberId"
                   label="Assign to"
                   required>
            @foreach (SelectListItem item in ViewBag.FamilyMembers)
            {
                <wa-option value="@item.Value">@item.Text</wa-option>
            }
        </wa-select>

        <div class="form-actions">
            <wa-button type="submit" variant="brand" appearance="filled">
                <wa-icon slot="start" name="floppy-disk"></wa-icon>
                Save Assignment
            </wa-button>
            <wa-button href="@Url.Action("Index")" variant="neutral" appearance="outlined">Cancel</wa-button>
        </div>
    </form>
</wa-card>
