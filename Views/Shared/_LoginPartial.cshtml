<div class="account-links">
@if (User.Identity?.IsAuthenticated ?? false)
{
    <span class="account-greeting">👋 Hello, @User.Identity.Name!</span>
    <a asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">
        <wa-icon name="arrow-right-from-bracket"></wa-icon>
        Sign Out
    </a>
}
else
{
    <a asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">
        <wa-icon name="key" variant="duotone"></wa-icon>
        Sign In
    </a>
}
</div>
