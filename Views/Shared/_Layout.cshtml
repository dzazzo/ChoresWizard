@inject IConfiguration Configuration
@{
    var webAwesomeKitCode = Configuration["WebAwesome:KitCode"];
}
<!DOCTYPE html>
<html lang="en" class="wa-cloak">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Sorting Hat</title>
    <script type="importmap"></script>
    @if (!string.IsNullOrWhiteSpace(webAwesomeKitCode))
    {
        <script type="module" src="https://kit.webawesome.com/@(webAwesomeKitCode).js"></script>
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Zazzo.ChoresWizard2000.styles.css" asp-append-version="true" />
</head>
<body>
    <wa-page mobile-breakpoint="800">
        <header slot="header" class="app-header">
            <a class="magical-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <wa-icon name="hat-wizard" variant="duotone"></wa-icon>
                The Sorting Hat
            </a>
            <partial name="_LoginPartial" />
        </header>

        <nav slot="navigation" class="app-navigation" aria-label="Primary navigation">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <wa-icon name="house" variant="duotone"></wa-icon>
                Home
            </a>
            <a asp-area="" asp-controller="FamilyMembers" asp-action="Index">
                <wa-icon name="family" variant="duotone"></wa-icon>
                Family
            </a>
            <a asp-area="" asp-controller="Chores" asp-action="Index">
                <wa-icon name="broom-wide" variant="duotone"></wa-icon>
                Chores
            </a>
            <a asp-area="" asp-controller="SortingHat" asp-action="Ceremony">
                <wa-icon name="sparkles" variant="duotone"></wa-icon>
                Sort
            </a>
        </nav>

        <main class="app-main" role="main">
            @if (string.IsNullOrWhiteSpace(webAwesomeKitCode))
            {
                <div class="configuration-warning" role="alert">
                    Web Awesome is not configured. Set <code>WebAwesome__KitCode</code> to load the UI kit.
                </div>
            }
            @RenderBody()
        </main>

        <footer slot="footer" class="app-footer">
            &copy; @DateTime.Now.Year - The Sorting Hat for the Zazzo Family ✨
        </footer>
    </wa-page>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
