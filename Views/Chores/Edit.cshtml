@model Zazzo.ChoresWizard2000.Models.Chore
@{
    ViewData["Title"] = "Edit Chore";
}

<header class="page-heading">
    <div>
        <h1>Edit Chore</h1>
        <p>Adjust how @Model.Name is distributed.</p>
    </div>
</header>

<wa-card class="form-card">
    <form asp-action="Edit" method="post" class="wa-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <partial name="_Form" model="@Model" />
        <div class="form-actions">
            <wa-button type="submit" variant="brand" appearance="filled">
                <wa-icon slot="start" name="floppy-disk"></wa-icon>
                Save
            </wa-button>
            <wa-button href="@Url.Action("Index")" variant="neutral" appearance="outlined">Cancel</wa-button>
        </div>
    </form>
</wa-card>
