@model List<Zazzo.ChoresWizard2000.Models.ChoreAssignment>
@{
    ViewData["Title"] = "The Sorting Hat - Chore Assignments";
}

<section class="hero">
    <h1 class="magical-title">🧙‍♂️ The Sorting Hat</h1>
    <p>Monthly Chore Distribution for the Zazzo Family</p>
</section>

@if (ViewData["DatabaseUnavailable"] is true)
{
    <wa-callout variant="warning" class="page-callout">
        <wa-icon slot="icon" name="wand-sparkles" variant="duotone"></wa-icon>
        The magic is still warming up — we couldn't reach the enchanted ledger just now. Please refresh in a moment.
    </wa-callout>
}

<div class="page-actions page-actions-centered">
    <wa-button href="@Url.Action("Ceremony", "SortingHat")" variant="brand" appearance="filled" size="large" class="magical-button">
        <wa-icon slot="start" name="hat-wizard" variant="duotone"></wa-icon>
        Perform Sorting Ceremony
    </wa-button>
    @if (Model != null && Model.Any())
    {
        <wa-button href="@Url.Action("Index", "Assignments")" variant="brand" appearance="outlined" size="large">
            <wa-icon slot="start" name="pen-to-square" variant="duotone"></wa-icon>
            Edit Assignments
        </wa-button>
        <form asp-controller="SortingHat" asp-action="ClearCurrentMonth" method="post"
              onsubmit="return confirm('Are you sure you want to clear all assignments for this month? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="native-button native-button-warning">
                🗑️ Clear This Month's Assignments
            </button>
        </form>
    }
</div>

@if (Model != null && Model.Any())
{
    <wa-card class="feature-card assignments-card">
        <div slot="header" class="card-heading">
            <wa-icon name="scroll-old" variant="duotone"></wa-icon>
            <h2>Current Month's Assignments - @DateTime.Now.ToString("MMMM yyyy")</h2>
        </div>
        <div class="member-stack">
            @foreach (var group in Model.GroupBy(a => a.FamilyMember))
            {
                <section class="member-section">
                    <h3 class="member-name">@group.Key?.Name</h3>
                    <div class="assignment-grid">
                        @foreach (var frequency in Enum.GetValues<Zazzo.ChoresWizard2000.Models.ChoreFrequency>())
                        {
                            <div>
                                <h4>📅 @frequency Chores</h4>
                                <ul class="chore-list">
                                    @foreach (var assignment in group.Where(a => a.Chore?.Frequency == frequency))
                                    {
                                        <li>
                                            <span>@assignment.Chore?.Name</span>
                                            <span class="badge-cluster">
                                                @if (assignment.Chore?.AssignToGroup != Zazzo.ChoresWizard2000.Models.AssignToGroup.OnePersonOnly)
                                                {
                                                    <wa-badge variant="success" pill>👥 Group</wa-badge>
                                                }
                                                else if (assignment.Chore?.PinnedToFamilyMemberId.HasValue == true)
                                                {
                                                    <wa-badge variant="warning" pill>📌 Pinned</wa-badge>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(assignment.Chore?.Category))
                                                {
                                                    <wa-badge variant="brand" pill>@assignment.Chore.Category</wa-badge>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    </wa-card>
}
else
{
    <wa-callout variant="brand" class="page-callout">
        <wa-icon slot="icon" name="sparkles" variant="duotone"></wa-icon>
        <strong>No chores assigned yet this month!</strong><br />
        Use the Sorting Ceremony to assign this month's chores.
    </wa-callout>
}

<section class="card-grid home-card-grid" aria-label="Management shortcuts">
    <wa-card class="feature-card">
        <wa-icon name="family" variant="duotone" class="feature-icon"></wa-icon>
        <h2>Family Members</h2>
        <p>Manage family members and age groups.</p>
        <wa-button slot="footer" href="@Url.Action("Index", "FamilyMembers")" variant="brand" appearance="outlined">Manage</wa-button>
    </wa-card>
    <wa-card class="feature-card">
        <wa-icon name="broom-wide" variant="duotone" class="feature-icon"></wa-icon>
        <h2>Chores</h2>
        <p>Manage the household chore list.</p>
        <wa-button slot="footer" href="@Url.Action("Index", "Chores")" variant="brand" appearance="outlined">Manage</wa-button>
    </wa-card>
    <wa-card class="feature-card">
        <wa-icon name="chart-column" variant="duotone" class="feature-icon"></wa-icon>
        <h2>View History</h2>
        <p>Review the current assignment history.</p>
        <wa-button slot="footer" href="@Url.Action("Index", "SortingHat")" variant="brand" appearance="outlined">View</wa-button>
    </wa-card>
</section>
