@model List<Zazzo.ChoresWizard2000.Models.ChoreAssignment>
@{
    ViewData["Title"] = "Assignment History";
}

<header class="page-heading">
    <div>
        <h1>📊 Assignment History</h1>
        <p>Review the current month's decree from the Sorting Hat.</p>
    </div>
</header>

@if (Model != null && Model.Any())
{
    <wa-card class="feature-card">
        <h2 slot="header">Current Month - @ViewData["CurrentMonthLabel"]</h2>
        <div class="member-stack">
            @foreach (var group in Model.GroupBy(a => a.FamilyMember))
            {
                <section>
                    <h3 class="member-name">@group.Key?.Name</h3>
                    <ul class="chore-list">
                        @foreach (var assignment in group)
                        {
                            <li>
                                <span>@assignment.Chore?.Name</span>
                                <wa-badge variant="neutral" pill>@assignment.Chore?.Frequency</wa-badge>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </wa-card>
}
else
{
    <wa-callout variant="brand" class="page-callout">
        <wa-icon slot="icon" name="sparkles" variant="duotone"></wa-icon>
        No assignments found for this month.
    </wa-callout>
}

<div class="page-actions">
    <wa-button href="@Url.Action("Index", "Home")" variant="neutral" appearance="outlined">
        <wa-icon slot="start" name="arrow-left"></wa-icon>
        Back to Home
    </wa-button>
</div>
