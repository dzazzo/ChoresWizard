@{
    ViewData["Title"] = "The Sorting Ceremony";
}

<section class="ceremony-container">
    <header class="hero">
        <h1 class="magical-title animated-title">🎩 The Sorting Hat</h1>
        <p class="mystical-text">The ancient hat that knows best...</p>
    </header>

    <div class="hat-container">
        <div class="sorting-hat">
            <span class="hat-icon">🎩</span>
        </div>
    </div>

    <div class="ceremony-message">
        <p class="ceremony-quote">"Hmm, difficult... Very difficult..."</p>
        <p>"Better be... Time to sort your chores!"</p>
    </div>

    <form asp-controller="SortingHat" asp-action="Sort" method="post" class="ceremony-form">
        @Html.AntiForgeryToken()
        <wa-button type="submit" variant="warning" appearance="filled" size="large" pill class="magical-sort-button">
            ✨ Begin the Sorting ✨
        </wa-button>
    </form>

    <wa-callout variant="warning" class="ceremony-callout">
        <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
        <strong>Note:</strong> This will assign chores for @ViewData["CurrentMonthLabel"].
        Previous assignments for this month will remain, but new sorting will add fresh assignments.
    </wa-callout>

    <wa-callout variant="brand" class="ceremony-callout">
        <wa-icon slot="icon" name="lightbulb" variant="duotone"></wa-icon>
        <strong>Tip:</strong> To start fresh, clear this month's assignments from the home page first.
    </wa-callout>

    <wa-button href="@Url.Action("Index", "Home")" variant="neutral" appearance="outlined" class="ceremony-back">
        <wa-icon slot="start" name="arrow-left"></wa-icon>
        Back to Home
    </wa-button>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const hat = document.querySelector('.sorting-hat');
        window.setInterval(() => createSparkle(hat), 500);
    });

    function createSparkle(element) {
        const sparkle = document.createElement('span');
        sparkle.textContent = '✨';
        sparkle.className = 'sparkle';
        sparkle.style.left = `${Math.random() * 100}%`;
        sparkle.style.top = `${Math.random() * 100}%`;
        sparkle.style.fontSize = `${Math.random() * 20 + 10}px`;
        element.parentElement.appendChild(sparkle);
        window.setTimeout(() => sparkle.remove(), 1000);
    }
</script>
