@model List<Zazzo.ChoresWizard2000.Models.ChoreAssignment>
@{
    ViewData["Title"] = "Sorting Complete!";
}

<section class="results-container">
    <header class="hero">
        <h1 class="result-title">✨ The Sorting is Complete! ✨</h1>
        <p>The Sorting Hat has spoken for @ViewData["CurrentMonthLabel"]</p>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="card-grid result-grid">
            @foreach (var group in Model.GroupBy(a => a.FamilyMember))
            {
                <wa-card class="member-card">
                    <h2 slot="header">@group.Key?.Name</h2>
                    @foreach (var frequency in Enum.GetValues<Zazzo.ChoresWizard2000.Models.ChoreFrequency>())
                    {
                        <section class="result-frequency">
                            <h3>📅 @frequency Chores</h3>
                            <ul class="chore-list">
                                @foreach (var assignment in group.Where(a => a.Chore?.Frequency == frequency))
                                {
                                    <li>
                                        <span>@assignment.Chore?.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(assignment.Chore?.Category))
                                        {
                                            <wa-badge variant="brand" pill>@assignment.Chore.Category</wa-badge>
                                        }
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </wa-card>
            }
        </div>
    }

    <div class="page-actions page-actions-centered">
        <wa-button href="@Url.Action("Index", "Home")" variant="brand" appearance="filled" size="large">
            <wa-icon slot="start" name="house" variant="duotone"></wa-icon>
            Return to Home
        </wa-button>
    </div>
</section>
